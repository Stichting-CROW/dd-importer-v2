{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "allOf": [
  {
   "description": "Response bodies must be a UTF-8 encoded JSON object and must minimally include the MDS `version`.",
   "properties": {
    "version": {
     "description": "The version of MDS this data represents.",
     "examples": [
      "2.0.0"
     ],
     "pattern": "^2\\.(\\d|[1-9]\\d+)\\.(\\d|[1-9]\\d+)$",
     "title": "data-type/version",
     "type": "string"
    }
   },
   "required": [
    "version"
   ],
   "title": "response/version",
   "type": "object"
  },
  {
   "properties": {
    "links": {
     "additionalProperties": false,
     "description": "If pagination is used for endpoints that support it, the pagination must comply with the [JSON API](http://jsonapi.org/format/#fetching-pagination) specification.",
     "properties": {
      "first": {
       "examples": [
        "https://data.provider.co/trips/first"
       ],
       "format": "uri",
       "title": "The URL to the first page of data.",
       "type": [
        "null",
        "string"
       ]
      },
      "last": {
       "examples": [
        "https://data.provider.co/trips/last"
       ],
       "format": "uri",
       "title": "The URL to the last page of data.",
       "type": [
        "null",
        "string"
       ]
      },
      "next": {
       "examples": [
        "https://data.provider.co/trips/next"
       ],
       "format": "uri",
       "title": "The URL to the next page of data.",
       "type": [
        "null",
        "string"
       ]
      },
      "prev": {
       "examples": [
        "https://data.provider.co/trips/prev"
       ],
       "format": "uri",
       "title": "The URL to the previous page of data.",
       "type": [
        "null",
        "string"
       ]
      }
     },
     "required": [
      "next"
     ],
     "type": "object"
    }
   },
   "title": "response/paging",
   "type": "object"
  },
  {
   "properties": {
    "last_updated": {
     "allOf": [
      {
       "description": "Integer milliseconds since Unix epoch.",
       "examples": [
        1514764800000,
        1681855703000
       ],
       "minimum": 1514764800000,
       "multipleOf": 1,
       "title": "data-types/timestamp",
       "type": "number"
      }
     ],
     "description": "Timestamp indicating the last time the data in this feed was updated."
    }
   },
   "required": [
    "last_updated"
   ],
   "title": "response/last_updated",
   "type": "object"
  },
  {
   "properties": {
    "ttl": {
     "allOf": [
      {
       "description": "An integer greater than or equal to 0.",
       "minimum": 0,
       "title": "data-types/integer-positive",
       "type": "integer"
      }
     ],
     "description": "Integer representing the number of milliseconds before the data in this feed will be updated again\n(0 if the data should always be refreshed). The data returned by a near-realtime endpoint should be as close to realtime\nas possible, but in no case should it be more than 5 minutes out-of-date.",
     "maximum": 300000
    }
   },
   "required": [
    "ttl"
   ],
   "title": "response/ttl",
   "type": "object"
  },
  {
   "description": "Vehicles status data payload",
