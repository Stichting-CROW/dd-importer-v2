                "agency_drop_off",
                "agency_pick_up",
                "battery_charged",
                "battery_low",
                "changed_geographies",
                "charging_end",
                "charging_start",
                "comms_lost",
                "comms_restored",
                "compliance_pick_up",
                "customer_cancellation",
                "decommissioned",
                "driver_cancellation",
                "fueling_end",
                "fueling_start",
                "located",
                "maintenance",
                "maintenance_end",
                "maintenance_pick_up",
                "not_located",
                "off_hours",
                "on_hours",
                "order_drop_off",
                "order_pick_up",
                "passenger_cancellation",
                "provider_cancellation",
                "provider_drop_off",
                "rebalance_pick_up",
                "recommission",
                "remote_end",
                "remote_start",
                "reservation_cancel",
